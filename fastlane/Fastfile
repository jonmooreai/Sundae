# TestFlight from CI, no Mac required.
#
# Needs these environment variables (GitHub secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT   App Store Connect API key (the .p8 contents, raw or base64)
#   APPLE_TEAM_ID                                 Developer team id
#   MATCH_PASSWORD                                Passphrase that encrypts the signing certificate
#   GITHUB_TOKEN                                  Lets match keep the encrypted certificate on a branch of this repo
# Optional:
#   BUNDLE_ID (default com.jonmooreai.sundae), APP_NAME (default Sundae), BUILD_NUMBER (default GITHUB_RUN_NUMBER)
#   MATCH_GIT_URL, MATCH_GIT_BRANCH, MATCH_GIT_TOKEN or MATCH_GIT_BASIC_AUTHORIZATION to keep the
#   certificate somewhere other than the "certificates" branch of this repository

require "base64"
require "spaceship"

default_platform(:ios)

platform :ios do
  desc "Build the app, sign it, and upload to TestFlight"
  lane :beta do
    bundle_id = ENV["BUNDLE_ID"] || "com.jonmooreai.sundae"
    widget_id = "#{bundle_id}.widget"
    team_id = ENV["APPLE_TEAM_ID"]

    setup_ci

    # The secret may hold the .p8 file as pasted or base64 encoded; either works.
    key_content = ENV["ASC_KEY_CONTENT"].to_s.strip
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: key_content,
      is_key_content_base64: !key_content.start_with?("-----BEGIN")
    )

    # App IDs and the App Store Connect record, through Spaceship with the API key. The produce
    # action only signs in with an Apple ID, which a runner cannot do. Idempotent: skips what exists.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    [[bundle_id, "Sundae"], [widget_id, "Sundae Widget"]].each do |identifier, name|
      if Spaceship::ConnectAPI::BundleId.find(identifier)
        UI.message("App ID #{identifier} already exists")
      else
        UI.message("Creating App ID #{identifier}")
        Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
      end
    end

    # App names are unique across the whole App Store, so fall back to longer names if "Sundae" is
    # taken. The name can be changed in App Store Connect at any time before release.
    base_name = ENV["APP_NAME"] || "Sundae"
    if Spaceship::ConnectAPI::App.find(bundle_id)
      UI.message("App Store Connect record for #{bundle_id} already exists")
    else
      candidates = [base_name, "#{base_name} Photo Dump", "#{base_name} #{team_id}"]
      created = candidates.any? do |app_name|
        begin
          UI.message("Creating App Store Connect record '#{app_name}'")
          Spaceship::ConnectAPI::App.create(
            name: app_name,
            version_string: "1.0",
            sku: "sundae-ios",
            primary_locale: "en-US",
            bundle_id: bundle_id,
            platforms: ["IOS"]
          )
          true
        rescue => e
          raise e unless e.message =~ /already|in use|not available|been used/i
          UI.important("App name '#{app_name}' is taken, trying the next one")
          false
        end
      end
      UI.user_error!("Could not create the App Store Connect record; every app name was taken") unless created
    end

    # The distribution certificate and profiles, created on first run and kept encrypted on a
    # branch of this repository (private). GitHub ignores the username when the password is a token.
    git_url = ENV["MATCH_GIT_URL"]
    git_url = "https://github.com/#{ENV['GITHUB_REPOSITORY']}.git" if git_url.to_s.empty?
    git_auth = ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    if git_auth.to_s.empty?
      token = ENV["MATCH_GIT_TOKEN"].to_s.empty? ? ENV["GITHUB_TOKEN"] : ENV["MATCH_GIT_TOKEN"]
      git_auth = Base64.strict_encode64("x-access-token:#{token}")
    end
    match(
      type: "appstore",
      app_identifier: [bundle_id, widget_id],
      api_key: api_key,
      team_id: team_id,
      readonly: false,
      git_url: git_url,
      git_branch: ENV["MATCH_GIT_BRANCH"] || "certificates",
      git_basic_authorization: git_auth
    )

    update_code_signing_settings(
      path: "Sundae.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      targets: ["Sundae"],
      bundle_identifier: bundle_id,
      profile_name: "match AppStore #{bundle_id}"
    )
    update_code_signing_settings(
      path: "Sundae.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      targets: ["SundaeWidget"],
      bundle_identifier: widget_id,
      profile_name: "match AppStore #{widget_id}"
    )

    # Each upload needs a higher build number; the workflow run number only goes up.
    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || "1"

    build_app(
      project: "Sundae.xcodeproj",
      scheme: "Sundae",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/testflight",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        provisioningProfiles: {
          bundle_id => "match AppStore #{bundle_id}",
          widget_id => "match AppStore #{widget_id}"
        }
      }
    )

    # Not waiting for processing keeps the runner minutes down; the build shows up in
    # App Store Connect a few minutes after upload.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
