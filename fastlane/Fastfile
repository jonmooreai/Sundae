# TestFlight from CI, no Mac required.
#
# Needs these environment variables (GitHub secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT   App Store Connect API key (the .p8 contents, raw or base64)
#   APPLE_TEAM_ID                                 Developer team id
#   MATCH_PASSWORD                                Passphrase that encrypts the signing certificate
#   MATCH_GIT_URL, MATCH_GIT_TOKEN                The private repository holding the encrypted certificate, and a
#                                                 fine-grained token with Contents read and write on it
# Optional:
#   BUNDLE_ID (default com.jonmooreai.sundae), BUILD_NUMBER (default GITHUB_RUN_NUMBER)
#   MATCH_GIT_BRANCH (default certificates), MATCH_GIT_BASIC_AUTHORIZATION in place of the token;
#   without MATCH_GIT_URL the lane falls back to a branch of this repository using GITHUB_TOKEN

require "base64"
require "spaceship"

default_platform(:ios)

platform :ios do
  desc "Build the app, sign it, and upload to TestFlight"
  lane :beta do
    bundle_id = ENV["BUNDLE_ID"] || "com.jonmooreai.sundae"
    widget_id = "#{bundle_id}.widget"
    team_id = ENV["APPLE_TEAM_ID"].to_s.strip

    setup_ci

    # The secret may hold the .p8 file as pasted or base64 encoded; either works.
    key_content = ENV["ASC_KEY_CONTENT"].to_s.strip
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: key_content,
      is_key_content_base64: !key_content.start_with?("-----BEGIN")
    )

    # App IDs through Spaceship with the API key. The produce action only signs in with an
    # Apple ID, which a runner cannot do. Idempotent: skips what exists.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    [[bundle_id, "Sundae"], [widget_id, "Sundae Widget"]].each do |identifier, name|
      if Spaceship::ConnectAPI::BundleId.find(identifier)
        UI.message("App ID #{identifier} already exists")
      else
        UI.message("Creating App ID #{identifier}")
        Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
      end
    end

    # Apple's public API can list and update apps but not create them (produce does it through an
    # Apple ID web session, which a runner cannot open). The record is a one-minute form.
    unless Spaceship::ConnectAPI::App.find(bundle_id)
      UI.user_error!(<<~MSG)
        No App Store Connect record exists for #{bundle_id} yet, and Apple's API does not allow creating one.
        Create it once at https://appstoreconnect.apple.com/apps (plus button, New App):
          Platforms: iOS
          Name: Sundae (or any name if that one is taken; it can be changed before release)
          Primary language: English (U.S.)
          Bundle ID: Sundae - #{bundle_id}
          SKU: sundae-ios
        Then run this workflow again.
      MSG
    end

    # The distribution certificate and profiles, created on first run and kept encrypted on a
    # branch of this repository (private). GitHub ignores the username when the password is a token.
    git_url = ENV["MATCH_GIT_URL"]
    git_url = "https://github.com/#{ENV['GITHUB_REPOSITORY']}.git" if git_url.to_s.empty?
    git_auth = ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    if git_auth.to_s.empty?
      token = ENV["MATCH_GIT_TOKEN"].to_s.empty? ? ENV["GITHUB_TOKEN"] : ENV["MATCH_GIT_TOKEN"]
      git_auth = Base64.strict_encode64("x-access-token:#{token}")
    end
    # [rotate-signing] in the commit message revokes the distribution certificate and profiles
    # and starts fresh, for when the encrypted store may have been exposed. Set a new
    # MATCH_PASSWORD first; the new certificate is encrypted with it.
    if ENV["ROTATE_SIGNING"] == "true"
      match_nuke(
        type: "appstore",
        api_key: api_key,
        team_id: team_id,
        git_url: git_url,
        git_branch: ENV["MATCH_GIT_BRANCH"] || "certificates",
        git_basic_authorization: git_auth,
        skip_confirmation: true
      )
    end

    match(
      type: "appstore",
      app_identifier: [bundle_id, widget_id],
      api_key: api_key,
      team_id: team_id,
      readonly: false,
      git_url: git_url,
      git_branch: ENV["MATCH_GIT_BRANCH"] || "certificates",
      git_basic_authorization: git_auth
    )

    # The API key belongs to exactly one team, and the profile match just made carries its id.
    # Trust that over the APPLE_TEAM_ID secret: Xcode only finds the profile under the right team.
    profile_team = ENV["sigh_#{bundle_id}_appstore_team-id"].to_s.strip
    if !profile_team.empty? && profile_team != team_id
      UI.important("APPLE_TEAM_ID is '#{team_id}' but the signing profile belongs to team '#{profile_team}'; using '#{profile_team}'")
      team_id = profile_team
    end

    update_code_signing_settings(
      path: "Sundae.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      targets: ["Sundae"],
      bundle_identifier: bundle_id,
      profile_name: "match AppStore #{bundle_id}"
    )
    update_code_signing_settings(
      path: "Sundae.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      targets: ["SundaeWidget"],
      bundle_identifier: widget_id,
      profile_name: "match AppStore #{widget_id}"
    )

    # Each upload needs a higher build number; the workflow run number only goes up.
    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || "1"

    build_app(
      project: "Sundae.xcodeproj",
      scheme: "Sundae",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/testflight",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        provisioningProfiles: {
          bundle_id => "match AppStore #{bundle_id}",
          widget_id => "match AppStore #{widget_id}"
        }
      }
    )

    # Not waiting for processing keeps the runner minutes down; the build shows up in
    # App Store Connect a few minutes after upload.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
