// Sundae's server: one Worker and one D1 database on Cloudflare's free plan, photos in R2 once
// it is switched on. No build step. Deployed by Workers Builds from this folder (docs/SERVER.md).
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "sundae-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  // No database_id: the first deploy creates the database and keeps it linked after that.
  "d1_databases": [{ "binding": "DB", "database_name": "sundae" }],
  // Until R2 is switched on, photos are kept in the database, which holds a few hundred.
  // Switch R2 on in the dashboard, then remove the two slashes below; the next deploy creates
  // the bucket. Photos already in the database stay readable.
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "sundae-photos" }],
  "vars": {
    "APPLE_BUNDLE_ID": "com.jonmooreai.sundae",
    // "true" opens the Sunday-only parts every day, for trying things out midweek.
    "SUNDAY_EVERY_DAY": "false"
  },
  // Clears photos that were uploaded but never posted, once a day.
  "triggers": { "crons": ["17 9 * * *"] },
  "observability": { "enabled": false }
}
